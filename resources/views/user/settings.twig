{% extends 'user.base' %}
{% block title %}Ustawienia{{ parent() }}{% endblock %}

{% import 'legacyComponents.forms' as forms %}

{% block content %}
  {{ form_start(form) }}

  <h2>Ustawienia główne</h2>
  <section class="card">
    <div class="card-body">
      {% if emailConfirmation %}
        <div class="alert alert-info">
          {{ icon('alertSuccess') }}
          {{ emailConfirmation }}
        </div>
      {% endif %}
      {{ form_row(form.email) }}
      {{ form_row(form.submit) }}
    </div>
  </section>

  <h2>Zgody</h2>
  <section class="card">
    <div class="card-body">
      {{ form_row(form.terms) }}
      {{ form_row(form.marketing_agreement) }}
      {{ form_row(form.newsletter_agreement) }}

      <div class="col-md-6 offset-md-4 mb-4">
        {{ informationClause }}
      </div>

      {{ form_row(form.submit) }}
    </div>
  </section>

  <h2>Informacje</h2>
  <section class="card">
    <div class="card-body">
      {{ form_row(form.website) }}
      {{ form_row(form.github) }}
      {{ form_row(form.firm) }}
      {{ form_row(form.position) }}
      {{ form_row(form.birthyear) }}
      {{ form_row(form.location) }}
      {{ form_row(form.bio) }}

      {{ form_row(form.submit) }}
    </div>
  </section>

  <h2>Forum</h2>
  <section class="card">
    <div class="card-body">
      {{ form_row(form.allow_subscribe) }}
      {{ form_row(form.group_id) }}
      {{ form_row(form.sig) }}

      {{ form_row(form.submit) }}
    </div>
  </section>

  <h2>Widok</h2>
  <section class="card">
    <div class="card-body">
      {{ form_row(form.date_format) }}
      {{ form_row(form.allow_sticky_header) }}
      {{ form_row(form.allow_smilies) }}
      {{ form_row(form.allow_count) }}
      {{ form_row(form.allow_sig) }}

      {{ form_row(form.submit) }}
    </div>
  </section>
  {{ form_close() }}

  <h2>Wykryta lokalizacja</h2>
  <section class="card">
    <div class="card-body">
      <div class="row">
        <div class="col-md-4"><strong>Na podstawie Cloudflare</strong></div>
        <div class="col-md-8">
          {% if cloudflareGeo %}
            {{ cloudflareGeo.city|default('') }}
            {% if cloudflareGeo.region %}, {{ cloudflareGeo.region }}{% endif %}
            {% if cloudflareGeo.country_code %}({{ cloudflareGeo.country_code }}){% endif %}
            {% if cloudflareGeo.latitude and cloudflareGeo.longitude %}
              <span class="text-muted small">
                &mdash; {{ cloudflareGeo.latitude }}, {{ cloudflareGeo.longitude }}
              </span>
            {% endif %}
          {% else %}
            <span class="text-muted">Brak danych</span>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <span class="d-none" id="cloudflare-headers">{{ cloudflareHeaders|json_encode|raw }}</span>
{% endblock %}

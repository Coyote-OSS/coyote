{% extends 'adm.base' %}
{% block title %}Strona główna {{ parent() }}{% endblock %}

{% block container %}
  <div class="card">
    <div class="card-header">Status systemu</div>
    <ul class="list-group list-group-flush">
      {% for item in checklist %}
        <li class="list-group-item">
          {% if item.value %}
            {{ icon('adminTickMark') }}
          {% else %}
            {{ icon('adminCrossMark') }}
          {% endif %}
          <span>{{ item.label }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>

  {% if cohortCanAccess %}
    <div class="card">
      <div class="card-header">Analiza kohortowa</div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item">
          <div class="d-flex justify-content-between align-items-center">
            <span>
              {{ icon('adminTickMark') }}
              <span>Dane kohortowe z: <code>{{ cohortByStream.downloadDate }}</code> (na podstawie dziennika zdarzeń)</span>
            </span>
            <a href="{{ cohortByStream.downloadUrl }}" class="btn btn-sm btn-secondary" target="_blank">
              Pobierz
            </a>
          </div>
        </li>
        <li class="list-group-item">
          <div class="d-flex justify-content-between align-items-center">
            <span>
              {{ icon('adminTickMark') }}
              <span>Dane kohortowe z: <code>{{ cohortByView.downloadDate }}</code> (na podstawie wyświetleń podstron)</span>
            </span>
            <a href="{{ cohortByView.downloadUrl }}" class="btn btn-sm btn-secondary" target="_blank">
              Pobierz
            </a>
          </div>
        </li>
      </ul>
    </div>
  {% endif %}
{% endblock %}

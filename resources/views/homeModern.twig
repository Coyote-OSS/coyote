{% extends 'layout' %}

{% block title %}4programmers.net – Największa Społeczność Programistyczna w Polsce + Job Board{% endblock %}
{% block description %}Dołącz do ponad 130 tys. zarejestrowanych programistów i skorzystaj z największego forum w Polsce. Szukasz pracy w IT, pomocy technicznej lub chcesz dzielić się wiedzą? Poznaj 4programmers.net już dziś!{% endblock %}
{% block keywords %}społeczność programistyczna, forum programistyczne, programiści w Polsce, praca IT, job board, oferty pracy, pomoc w programowaniu, 4programmers{% endblock %}

{% import 'legacyComponents.modals' as modal %}
{% import _self as home %}
{% from 'progressBar.progressBar' import progressBar %}
{% from 'campaignBanner.campaignBanner' import campaignBanner %}
{% from 'prototypeVoteBanner.prototypeVoteBanner' import prototypeVoteBanner %}

{% block container %}
  {{ render_block('homepage_banner') }}

  {% if campaign_banners_home_desktop.horizontal or campaign_banners_home_mobile.horizontal %}
    <div class="row">
      <div class="col-12 mt-4">
        {{ campaignBanner('header', campaign_banners_home_desktop, campaign_banners_home_mobile) }}
      </div>
    </div>
  {% endif %}
  <div class="row">
    <main class="col-lg-8 home-column">
      {{ home.topicList('home-interesting', 'Najciekawsze na forum', interesting, topicLikes, topicParticipants) }}

      <section id="box-activity">
        <h2 class="home-section-title">Ostatnia aktywność</h2>
        <div class="home-activities">
          {% set activityKinds = {
            topic:   {label: 'Nowy wątek', icon: 'homepageActivityTopic'},
            post:    {label: 'Odpowiedź', icon: 'homepageActivityPost'},
            comment: {label: 'Komentarz', icon: 'homepageActivityPostComment'},
          } %}
          {% for activity in activities %}
            <article class="home-activity neon-tile neon-rounded {{ loop.index > 6 ? 'home-activity--folded' }} {{ activity.blocked ? 'home-activity--blocked' }}">
              {% if activity.blocked %}
                <button type="button" class="home-activity__blocked" title="Kliknij, aby pokazać treść">
                  {{ icon('postAuthorBlocked') }}
                  Treść została ukryta, ponieważ autorem jest zablokowany przez Ciebie użytkownik.
                </button>
              {% endif %}
              <header class="home-activity__header">
                <a href="{{ activity.user.url ?: '#' }}" class="flex-shrink-0">
                  <div class="neon-avatar-border home-activity__avatar">
                    {{ user_avatar(activity.user.photo, activity.user.name) }}
                  </div>
                </a>
                <div class="home-activity__who">
                  <div>
                    {% if activity.user.url %}
                      <a href="{{ activity.user.url }}" class="home-activity__user" data-user-id="{{ activity.user_id }}">{{ activity.user.name }}</a>
                    {% else %}
                      <span class="home-activity__user">{{ activity.user.name }}</span>
                    {% endif %}
                    <span class="home-activity__kind home-activity__kind--{{ activity.kind }}">{{ icon(activityKinds[activity.kind].icon) }} {{ activityKinds[activity.kind].label }}</span>
                  </div>
                  <div class="home-activity__meta">
                    <a href="{{ activity.forum.url }}" class="home-chip">{{ activity.forum.name }}</a>
                    <span title="{{ activity.created_at|format_date(false) }}">{{ activity.created_at|format_date }}</span>
                  </div>
                </div>
              </header>
              <a href="{{ activity.kind == 'topic' ? activity.topic.url : activity.url }}" class="home-activity__content">
                <span class="home-activity__topic">
                  {% if activity.kind != 'topic' %}<span class="home-activity__topic-prefix">w wątku</span>{% endif %}
                  {{ activity.topic.title }}
                </span>
                {% if activity.excerpt %}
                  <span class="home-activity__excerpt">{{ activity.excerpt }}</span>
                {% endif %}
              </a>
              <footer class="home-activity__actions">
                {% set ownContent = user('id') and user('id') == activity.user_id %}
                {% if not user('id') %}
                  <a href="{{ route('login') }}" class="home-activity__action" title="Zaloguj się, aby oddać głos">
                    {{ icon('homepageActivityVote') }}
                    <span>{{ activity.score }}</span>
                  </a>
                {% else %}
                  <button
                      type="button"
                      class="home-activity__action home-activity__vote {{ activity.voted ? 'home-activity__vote--voted' }}"
                      data-vote-type="{{ activity.vote.type }}"
                      data-vote-id="{{ activity.vote.id }}"
                      {{ ownContent ? 'disabled' }}
                      title="{{ ownContent ? 'Nie możesz głosować na swój wpis' : (activity.kind == 'comment' ? 'Doceń komentarz' : 'Doceń post') }}">
                    <span class="home-activity__vote-icon">{{ icon('homepageActivityVote') }}</span>
                    <span class="home-activity__voted-icon">{{ icon('homepageActivityVoted') }}</span>
                    <span class="home-activity__score">{{ activity.score }}</span>
                  </button>
                {% endif %}
                {% if activity.comments is not null %}
                  <a href="{{ activity.url }}" class="home-activity__action" title="Komentarze">
                    {{ icon('homepageActivityComments') }}
                    <span>{{ activity.comments }}</span>
                  </a>
                {% endif %}
                <a href="{{ activity.url }}" class="home-activity__action ms-auto">
                  {{ icon('homepageActivityReply') }}
                  <span>Odpowiedz</span>
                </a>
              </footer>
            </article>
          {% endfor %}
        </div>
        {% if activities|length > 6 %}
          <button type="button" id="home-activities-more" class="home-more neon-tile neon-rounded">
            Pokaż więcej aktywności
            {{ icon('homepageActivityShowMore') }}
          </button>
        {% endif %}
      </section>

      <section id="js-microblog">
        <h2 class="home-section-title">Popularne na mikroblogu</h2>
        <vue-microblog
            v-for="microblog in microblogs" :key="microblog.id" :microblog="microblog"
            :wrap="true"></vue-microblog>
        <vue-notifications></vue-notifications>
        <a href="{{ route('microblog.home') }}" class="home-more neon-tile neon-rounded">
          Przejdź do mikroblogów
          {{ icon('homepageMore') }}
        </a>
      </section>
    </main>

    <div class="col-lg-4 position-relative home-docked-gutter">
      <aside class="home-column">
        {{ render_block('homepage_banner_side') }}

        {{ home.topicList('home-newest', 'Nowe wątki', newest, topicLikes, {}, route('forum.all'), 'Wszystkie wątki na forum') }}

        <section id="home-members" class="home-members neon-tile neon-rounded {{ settings.membersDocked ? 'home-members--docked' }}">
          <header class="home-members__header">
            <h2 class="home-card-title">Społeczność</h2>
            <span class="home-members__count">
              <span class="members-banner__online-indicator d-inline-block me-1"></span>
              {{ community.onlineCount }} online
            </span>
            <button type="button" class="home-members__dock" id="home-members-dock"
                    title="Odepnij od strony głównej i przypnij do boku ekranu"
                    aria-label="Odepnij od strony głównej i przypnij do boku ekranu">
              {{ icon('homepageMembersDock') }}
            </button>
            <button type="button" class="home-members__dock" id="home-members-undock"
                    title="Przypnij z powrotem do strony głównej"
                    aria-label="Przypnij z powrotem do strony głównej">
              {{ icon('homepageMembersUndock') }}
            </button>
          </header>
          <ul class="home-members__list" data-online-shown="10" data-recent-shown="5">
            {% if community.online is not empty or community.guestsCount > 0 %}
              <li class="home-members__divider">Online</li>
            {% endif %}
            {% set onlineShown = 10 %}{# keep in sync with data-online-shown #}
            {% set recentShown = 5 %}{# keep in sync with data-recent-shown #}
            {% for member in community.online %}
              {{ home.member(member, 'online', loop.index > onlineShown) }}
            {% endfor %}
            {% if community.online|length > onlineShown %}
              <li class="home-members__more">
                <button type="button" class="home-members__more-button" id="home-members-more-online">
                  Pokaż wszystkich online ({{ community.online|length }})
                </button>
              </li>
            {% endif %}
            {% if community.onlineHidden > 0 %}
              <li class="home-members__note">i {{ declination(community.onlineHidden, ['inna osoba', 'inne osoby', 'innych osób']) }} online</li>
            {% endif %}
            {% if community.guestsCount > 0 %}
              <li class="home-members__guests">
                <span class="home-members__guests-pill" title="Niezalogowani użytkownicy, którzy są teraz na stronie">
                  <span class="home-members__guests-dot"></span>
                  {{ icon('homepageMembersGuests') }}
                  +{{ declination(community.guestsCount, ['niezalogowany gość', 'niezalogowanych gości', 'niezalogowanych gości']) }}
                </span>
              </li>
            {% endif %}
            {% if community.recent is not empty %}
              <li class="home-members__divider">Ostatnio widziani</li>
              {% for member in community.recent %}
                {{ home.member(member, 'recent', loop.index > recentShown) }}
              {% endfor %}
              {% if community.recent|length > recentShown %}
                <li class="home-members__more">
                  <button type="button" class="home-members__more-button" id="home-members-more-recent">
                    Pokaż więcej offline
                  </button>
                </li>
              {% endif %}
            {% endif %}
          </ul>
        </section>

        {{ render_block('job_ads') }}

        <section class="neon-tile neon-rounded home-reputation">
          <header class="home-members__header">
            <h2 class="home-card-title">Reputacja</h2>
          </header>
          <div id="reputation-tabs" class="nav nav-pills neon-tabber">
            <span data-bs-toggle="tab" data-bs-target="#week"
                  class="nav-link neon-tabber-tab {{ settings.reputationMode == 'week' ? 'active' }}">Tydzień</span>
            <span data-bs-toggle="tab" data-bs-target="#month"
                  class="nav-link neon-tabber-tab {{ settings.reputationMode == 'month' ? 'active' }}">Miesiąc</span>
            <span data-bs-toggle="tab" data-bs-target="#quarter"
                  class="nav-link neon-tabber-tab {{ settings.reputationMode == 'quarter' ? 'active' }}">Kwartał</span>
          </div>
          <div class="tab-content">
            {% for tab, users in reputation %}
              <ol id="{{ tab }}" role="tabpanel" class="tab-pane home-reputation__list {{ settings.reputationMode == tab ? 'active' }}">
                {% for user in users %}
                  <li class="home-reputation__item">
                    <span class="home-reputation__rank">{{ loop.index }}</span>
                    <a href="{{ route('profile', [user.id]) }}" class="home-member__avatar">
                      {{ user_avatar(user.photo, user.name) }}
                    </a>
                    <div class="home-reputation__user">
                      <a class="home-member__name d-block" data-user-id="{{ user.id }}" href="{{ route('profile', [user.id]) }}">{{ user.name }}</a>
                      {{ progressBar(user.percentage|round) }}
                    </div>
                    <span class="home-reputation__points">{{ user.reputation }} pkt</span>
                  </li>
                {% else %}
                  <li class="text-muted text-center py-4 small">
                    Bądź pierwszą osobą, która otrzyma punkty reputacji w tym okresie.
                  </li>
                {% endfor %}
              </ol>
            {% endfor %}
          </div>
        </section>

        {% if campaign_banners_home_desktop.sidebar or campaign_banners_home_mobile.sidebar %}
          <div>
            {{ campaignBanner('square', campaign_banners_home_desktop, campaign_banners_home_mobile) }}
          </div>
        {% endif %}
      </aside>
    </div>
  </div>

  <script type="text/javascript">
    var microblogs = {{ microblogs|json_encode|raw }};
    var flags = {{ flags|json_encode|raw }};
    var emojis = {{ emojis|json_encode|raw }};
  </script>
{% endblock %}

{% macro topicList(id, title, topics, likes, participants = {}, moreUrl = null, moreLabel = null) %}
  <section id="{{ id }}" class="home-topic-list">
    <h2 class="home-section-title">{{ title }}</h2>
    <div class="neon-tile neon-rounded home-topics">
      {% for topic in topics %}
        <div class="home-topic">
          <div class="home-topic__replies {{ topic.replies > 0 ? 'home-topic__replies--answered' }}"
               title="{{ declination(topic.replies, ['odpowiedź', 'odpowiedzi', 'odpowiedzi']) }}">
            {{ icon('homepageTopicReplies') }}
            <strong>{{ topic.replies }}</strong>
          </div>
          <div class="home-topic__body">
            <a href="{{ route('forum.topic', [topic.forum_slug, topic.id, topic.slug]) }}" class="home-topic__title" title="{{ topic.title }}">
              {{ topic.title }}
            </a>
            <div class="home-topic__meta">
              <a href="{{ route('forum.category', [topic.forum_slug]) }}" class="home-chip">{{ topic.forum }}</a>
              {# replaces the replies counter on the left, where it is hidden (see stylesheet) #}
              <span class="home-topic__meta-replies" title="{{ declination(topic.replies, ['odpowiedź', 'odpowiedzi', 'odpowiedzi']) }}">
                {{ icon('homepageTopicReplies') }} {{ topic.replies }}
              </span>
              <span title="{{ declination(topic.views, ['wyświetlenie', 'wyświetlenia', 'wyświetleń']) }}">
                {{ icon('homepageTopicViews') }} {{ topic.views }}
              </span>
              {% set topicLikes = likes[topic.id] ?? 0 %}
              {% if topicLikes > 0 %}
                <span title="{{ declination(topicLikes, ['polubienie', 'polubienia', 'polubień']) }} we wszystkich postach">
                  {{ icon('homepageTopicScore') }} {{ topicLikes }}
                </span>
              {% endif %}
              <span class="home-topic__date" title="{{ topic.replies > 0 ? 'Ostatnia odpowiedź' : 'Utworzono' }}: {{ topic.last_post_created_at|format_date(false) }}">
                {{ topic.last_post_created_at|format_date }}
              </span>
            </div>
          </div>
          {% if participants[topic.id] is defined %}
            <div class="home-topic__participants">
              {% for user in participants[topic.id].users %}
                {# most active participant on top: each avatar covers the next one #}
                <a href="{{ user.profileUrl }}" class="home-topic__participant" style="z-index:{{ loop.revindex }}"
                   title="{{ user.name }}: {{ declination(user.posts, ['post', 'posty', 'postów']) }}">
                  {{ user_avatar(user.avatarUrl, user.name) }}
                </a>
              {% endfor %}
              {% if participants[topic.id].more > 0 %}
                <span class="home-topic__participant home-topic__participant--more" style="z-index:2"
                      title="i {{ declination(participants[topic.id].more, ['inna osoba', 'inne osoby', 'innych osób']) }}">
                  +{{ participants[topic.id].more }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% else %}
        <small class="d-block text-muted text-center py-4">Brak wątków do wyświetlenia.</small>
      {% endfor %}
    </div>
    {% if moreUrl %}
      <a href="{{ moreUrl }}" class="home-more neon-tile neon-rounded">
        {{ moreLabel }}
        {{ icon('homepageMore') }}
      </a>
    {% endif %}
  </section>
{% endmacro %}

{# A user in the community list. Rows are re-sorted in the browser when the panel is pinned/unpinned,
   so they carry their group, original order and whether they're followed. #}
{% macro member(member, group, extra) %}
  <li class="home-members__item {{ extra ? 'home-members__extra home-members__extra--' ~ group }}"
      data-member-group="{{ group }}" data-member-order="{{ member.order }}" data-followed="{{ member.followed ? 1 : 0 }}">
    <a href="{{ member.profileUrl }}" class="home-member" data-user-id="{{ member.id }}">
      <span class="home-member__avatar {{ group == 'online' ? 'home-member__avatar--online' }}">
        {{ user_avatar(member.avatarUrl, member.name) }}
      </span>
      <span class="home-member__name">
        <span class="home-member__username">{{ member.name }}</span>
        {% if member.group %}<span class="home-member__badge">{{ member.group }}</span>{% endif %}
      </span>
      {% if group == 'online' %}
        <small class="home-member__status home-member__status--online">online</small>
      {% else %}
        <small class="home-member__status" title="Ostatnia wizyta: {{ member.visitedAt|format_date(false) }}">
          {{ member.visitedAt|format_date }}
        </small>
      {% endif %}
    </a>
    {% if user('id') and user('id') != member.id %}
      <span class="home-member__actions">
        <a href="{{ route('user.pm.submit', {to: member.name}) }}" class="home-member__action home-member__message"
           title="Napisz prywatną wiadomość do {{ member.name }}">
          {{ icon('homepageMemberMessage') }}
        </a>
        <button type="button"
                class="home-member__action home-member__follow {{ member.followed ? 'home-member__follow--followed' }}"
                data-follow-user-id="{{ member.id }}"
                aria-pressed="{{ member.followed ? 'true' : 'false' }}"
                title="{{ member.followed
                  ? 'Obserwujesz ' ~ member.name ~ '. Obserwowani są wyświetlani na górze listy. Kliknij, aby przestać obserwować.'
                  : 'Obserwuj ' ~ member.name ~ '. Obserwowani są wyświetlani na górze listy.' }}">
          <span class="home-member__follow-icon">{{ icon('homepageMemberFollow') }}</span>
          <span class="home-member__followed-icon">{{ icon('homepageMemberFollowed') }}</span>
        </button>
      </span>
    {% endif %}
  </li>
{% endmacro %}

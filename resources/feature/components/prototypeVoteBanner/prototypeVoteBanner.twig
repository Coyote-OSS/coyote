{% macro prototypeVoteBanner(topicHref) %}
  {% set pitch = 51.5 %}
  {% set outlineCells = [
    [0, 1], [0, 4], [0, 5],
    [1, 0], [1, 2], [1, 3], [1, 4], [1, 5], [1, 6],
    [2, 1], [2, 2], [2, 4], [2, 6],
    [3, 0], [3, 2], [3, 3], [3, 5],
  ] %}
  {% set prototypeCells = [[0, 3, 'A'], [1, 1, 'B'], [2, 5, 'C']] %}
  <section class="prototype-vote-banner">
    <div class="prototype-vote-banner__mosaic" aria-hidden="true">
      <div class="prototype-vote-banner__outlines">
        {% for cell in outlineCells %}
          <span class="prototype-vote-banner__outline" style="top: {{ cell[0] * pitch }}px; right: {{ cell[1] * pitch }}px"></span>
        {% endfor %}
      </div>
      {% for cell in prototypeCells %}
        <span class="prototype-vote-banner__prototype" style="top: {{ cell[0] * pitch }}px; right: {{ cell[1] * pitch }}px">{{ cell[2] }}</span>
      {% endfor %}
    </div>
    <div class="prototype-vote-banner__content">
      <img src="{{ cdn('img/logo.light.svg') }}" alt="4programmers.net" class="prototype-vote-banner__logo prototype-vote-banner__logo--light">
      <img src="{{ cdn('img/logo.dark.svg') }}" alt="4programmers.net" class="prototype-vote-banner__logo prototype-vote-banner__logo--dark">
      <h2 class="prototype-vote-banner__title">Nowy interfejs 4programmers – wybierz kierunek</h2>
      <p class="prototype-vote-banner__text">
        Przygotowaliśmy 3 prototypy nowego 4programmers. Zobacz je i zagłosuj na ten,
        który podoba Ci się najbardziej –
        <strong>Twój głos zdecyduje, w którą stronę pójdziemy.</strong>
      </p>
      <a href="{{ topicHref }}" class="prototype-vote-banner__button">Wybierz prototyp</a>
    </div>
    <button type="button" class="prototype-vote-banner__close" title="Ukryj" aria-label="Ukryj">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M4 4l8 8M12 4l-8 8"/>
      </svg>
    </button>
  </section>
  <script>
    (function (banner) {
      var storageKey = 'prototypeVoteBanner';
      try {
        if (localStorage.getItem(storageKey) === 'dismissed') {
          banner.remove();
          return;
        }
      } catch (error) {
        // storage unavailable (private mode, blocked site data); banner stays visible
      }
      banner.querySelector('.prototype-vote-banner__close').addEventListener('click', function () {
        banner.remove();
        try {
          localStorage.setItem(storageKey, 'dismissed');
        } catch (error) {
          // storage unavailable; banner stays hidden until reload
        }
      });
    })(document.currentScript.previousElementSibling);
  </script>
{% endmacro %}
